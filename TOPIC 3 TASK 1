# Net Salary Calculator

# i. Get input from the user
name = input("Enter employee name: ")
basic_salary = input("Enter basic salary: ")
deduction = input("Enter monthly deduction: ")

# ii. Convert salary and deduction to floating-point numbers
basic_salary = float(basic_salary)
deduction = float(deduction)

# iii. Housing allowance = 10% of basic salary
housing_allowance = 0.10 * basic_salary

# iv. Gross salary = basic salary + housing allowance
gross_salary = basic_salary + housing_allowance

# v. Net salary = gross salary - deduction
net_salary = gross_salary - deduction

# vi. Display results
print("\n----- Salary Summary -----")
print(f"Employee Name     : {name}")
print(f"Basic Salary      : {basic_salary:,.2f}")
print(f"Housing Allowance : {housing_allowance:,.2f}")
print(f"Gross Salary      : {gross_salary:,.2f}")
print(f"Deduction         : {deduction:,.2f}")
print(f"Net Salary        : {net_salary:,.2f}")
